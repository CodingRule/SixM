{
  "name": "sixm",
  "version": "0.1.0",
  "description": "SixM - open-source multiplayer framework for GTA VI (GTA 6): Lua-scripted dedicated server, resources and client. Pre-alpha.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sixm-server": "bin/sixm-server.js",
    "sixm-client": "bin/sixm-client.js"
  },
  "scripts": {
    "start": "node bin/sixm-server.js",
    "client": "node bin/sixm-client.js",
    "test": "node --test \"test/*.test.js\"",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "dependencies": {
    "fengari": "^0.1.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  },
  "keywords": [
    "gta6",
    "gta-vi",
    "gta 6 multiplayer",
    "multiplayer",
    "game-server",
    "dedicated-server",
    "lua",
    "roleplay",
    "modding",
    "sixm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CodingRule/SixM.git"
  },
  "homepage": "https://github.com/CodingRule/SixM#readme",
  "bugs": "https://github.com/CodingRule/SixM/issues"
}
